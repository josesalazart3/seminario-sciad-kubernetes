# ============================================================
# SCIAD — Variables de PRODUCCIÓN (plantilla)
# Copia a `.env.prod` y rellena valores REALES. `.env.prod`
# NO se versiona (ver .gitignore). Uso:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=sciad
POSTGRES_USER=sciad
# GENERA una contraseña fuerte:  openssl rand -base64 24
POSTGRES_PASSWORD=change-me-strong-password
# Conexiones concurrentes (ver DESPLIEGUE.md §2.3)
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_MAX_POOL=200

# --- Backend (JWT) ---
# Mínimo 32 chars (fail-fast). Genera:  openssl rand -base64 48
SCIAD_JWT_SECRET=change-me-a-very-long-secret-key-of-at-least-32-chars

# --- Credenciales QR (sobre cifrado AES-256-GCM) ---
# OBLIGATORIA: 32 bytes en base64 (fail-fast). Genere:  openssl rand -base64 32
# Guárdela en el gestor de contraseñas y respáldela con este archivo: perderla o cambiarla invalida TODOS los QR emitidos.
QR_ENCRYPTION_KEY=

# Origen CORS (mismo dominio del SPA; separar con comas)
SCIAD_CORS_ORIGINS=https://sciad.gt
# Hosts aceptados por la API (separados por punto y coma; sin puerto; localhost lo usa el healthcheck).
# docker-compose.prod.yml lo usa; si falta, cae al valor por defecto (sciad.gt) y la API rechaza otros dominios.
ALLOWED_HOSTS=sciad.gt;www.sciad.gt;localhost

# Rate limit de login (SEC-04)
RATE_LIMIT_LOGIN_PERMIT=5
RATE_LIMIT_LOGIN_WINDOW=300

# --- Administrador inicial (en producción NO existen cuentas demo) -------------------------------------------
# Se crea al primer arranque si no existe. La contraseña debe ser FUERTE (≥ 12 caracteres, mayúsculas, minúsculas,
# números y símbolo) o el backend NO arranca. Cámbiela por la interfaz después del primer ingreso si lo desea.
SCIAD_ADMIN_EMAIL=admin@su-dominio.gt
SCIAD_ADMIN_PASSWORD=

# Genere secretos fuertes (no use los de ejemplo):
#   openssl rand -base64 48        → SCIAD_JWT_SECRET
#   openssl rand -base64 32        → QR_ENCRYPTION_KEY
#   openssl rand -base64 24        → POSTGRES_PASSWORD